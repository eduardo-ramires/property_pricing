# Credenciais do Postgres (usadas pelo serviço postgres do docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=precificajusta

# URL de conexão do Postgres usada pelo Prisma quando rodando FORA do Docker
# (dentro do docker-compose, o serviço "app" recebe uma URL apontando para "postgres" em vez de "localhost")
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/precificajusta?schema=public"

# URL de conexão do Redis usada FORA do Docker (cache/filas, ainda não utilizado)
REDIS_URL="redis://localhost:6379"

# Porta em que o Next.js roda
PORT=3000
